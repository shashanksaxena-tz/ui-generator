# ==============================================================================
# AI Provider (at least one required)
# ==============================================================================

# Default AI provider: "google" (Gemini), "openai", or "anthropic"
AI_PROVIDER=google

# Default model (per provider)
# google: gemini-2.0-flash, gemini-2.5-pro-preview-05-06
# openai: gpt-4o, gpt-4o-mini
# anthropic: claude-sonnet-4-20250514
AI_MODEL=gemini-2.0-flash

# Provider API keys (at least one required)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# MCP Server API Keys (all optional -- only needed if you enable those servers)
# ==============================================================================

# 21st.dev Magic -- AI component generation
# Get free key at: https://21st.dev/magic/console
TWENTY_FIRST_DEV_API_KEY=

# Figma -- design-to-code bridge
# Get token at: Figma > Settings > Personal Access Tokens
FIGMA_API_KEY=

# GitHub -- higher rate limits for ReactBits MCP (5000 vs 60 req/hr)
# Get token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Chakra UI Pro -- premium component templates (optional)
CHAKRA_PRO_API_KEY=

# DaisyUI Blueprint -- paid license ($600 lifetime)
# Purchase at: https://daisyui.com/blueprint/
DAISYUI_LICENSE=
DAISYUI_EMAIL=

# Context7 -- higher rate limits for doc queries (optional)
# Get key at: https://context7.com/dashboard
CONTEXT7_API_KEY=

# ==============================================================================
# App
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
