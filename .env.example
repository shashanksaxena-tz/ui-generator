# AI Provider Keys (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default AI provider: "openai" or "anthropic"
AI_PROVIDER=openai

# Default model
AI_MODEL=gpt-4o

# MCP Server URLs (optional, comma-separated)
MCP_SERVERS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
