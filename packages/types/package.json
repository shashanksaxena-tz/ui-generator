{
  "name": "@generative-ui/types",
  "version": "0.1.0",
  "description": "Core TypeScript types and Zod schemas for the Generative UI Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./syntux": {
      "import": "./dist/syntux.mjs",
      "require": "./dist/syntux.js",
      "types": "./dist/syntux.d.ts"
    },
    "./tambo": {
      "import": "./dist/tambo.mjs",
      "require": "./dist/tambo.js",
      "types": "./dist/tambo.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.mjs",
      "require": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.js",
      "types": "./dist/theme.d.ts"
    },
    "./generation": {
      "import": "./dist/generation.mjs",
      "require": "./dist/generation.js",
      "types": "./dist/generation.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.mjs",
      "require": "./dist/agent.js",
      "types": "./dist/agent.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/syntux.ts src/tambo.ts src/mcp.ts src/theme.ts src/generation.ts src/agent.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "keywords": [
    "generative-ui",
    "types",
    "zod",
    "typescript",
    "react",
    "syntux",
    "tambo",
    "mcp"
  ],
  "license": "MIT"
}
