{
  "extends": "@generative-ui/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@generative-ui/types": ["../../packages/types/src"],
      "@generative-ui/agents": ["../../packages/agents/src"],
      "@generative-ui/mcp": ["../../packages/mcp/src"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
